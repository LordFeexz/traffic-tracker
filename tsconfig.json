{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "traffic-tracker": ["./src/index.ts"],
      "traffic-tracker/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
